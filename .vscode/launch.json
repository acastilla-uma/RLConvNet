// .vscode/launch.json
{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug rl_convnet_simple",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/rl_convnet_simple.exe",
      "args": [
        "--reward",
        "${workspaceFolder}/sim_maps/map_d0.7_s42_sm3_cr2/reward.csv",
        "--tol", "1e-3",
        "--k-max", "1000"
      ],
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
      "externalConsole": false
    }
  ]
}